# NexusPanel Environment Variables Template
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DOMAIN=panel.yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# PostgreSQL Connection
POSTGRES_USER=nexus
POSTGRES_PASSWORD=replace_with_strong_random_db_password
POSTGRES_DB=nexuspanel
DATABASE_URL=postgresql://nexus:replace_with_strong_random_db_password@postgres:5432/nexuspanel?schema=public

# Redis Connection
REDIS_URL=redis://redis:6379

# Cryptography & Security
JWT_SECRET=generate_with_openssl_rand_hex_32
MASTER_ENCRYPTION_KEY=generate_32_bytes_hex_string_here

# Node Agent
AGENT_TOKEN=generate_with_openssl_rand_hex_32
DATA_DIR=/var/lib/nexuspanel/volumes
